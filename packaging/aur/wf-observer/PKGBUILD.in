# Maintainer: WhaleFromMars <oliverstevenscoughlan at protonmail dot com>

pkgname=wf-observer
pkgver=@VERSION@
pkgrel=1
pkgdesc='Read-only Warframe process observer with an Iroh endpoint'
arch=('x86_64')
options=('!lto')
url='https://github.com/Open-WF/wf-observer'
license=('MIT OR Apache-2.0')
depends=('glibc' 'libgcc')
makedepends=('cargo')
conflicts=('wf-observer-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/cli-v$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
    cd "$pkgname-cli-v$pkgver"
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd "$pkgname-cli-v$pkgver"
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --package wf-observer-cli
}

check() {
    cd "$pkgname-cli-v$pkgver"
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release --package wf-observer-cli
}

package() {
    cd "$pkgname-cli-v$pkgver"
    install -Dm755 target/release/wf-observer "$pkgdir/usr/bin/wf-observer"
    install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
    install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname"
}
